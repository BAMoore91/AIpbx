# ============================================================================
# AIpbx — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ============================================================================

# ---- General ----
NODE_ENV=production
DOMAIN=pbx.example.com                 # public FQDN (TLS + SIP/WebRTC)
PUBLIC_IP=                             # droplet public IP (set by deploy script)
TZ=UTC

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aipbx
POSTGRES_USER=aipbx
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://aipbx:change-me-strong-password@postgres:5432/aipbx

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379

# ---- API service (Node/TS) ----
API_PORT=3000
JWT_SECRET=change-me-64-char-random-secret
JWT_REFRESH_SECRET=change-me-another-64-char-random-secret
JWT_ACCESS_TTL=900            # 15 min
JWT_REFRESH_TTL=2592000       # 30 days
CORS_ORIGINS=https://pbx.example.com
ENCRYPTION_KEY=change-me-32-byte-base64-key   # for SIP secrets / trunk creds at rest

# ---- Asterisk ARI ----
ARI_URL=http://asterisk:8088
ARI_USERNAME=ariuser
ARI_PASSWORD=change-me-ari-password
ARI_APP=aipbx
ASTERISK_HOST=asterisk
ASTERISK_SIP_PORT=5060
ASTERISK_TLS_PORT=5061
ASTERISK_WSS_PORT=8089
RTP_START=10000
RTP_END=10200

# ---- AI Engine (Python) ----
AI_ENGINE_PORT=8080
AUDIOSOCKET_HOST=0.0.0.0
AUDIOSOCKET_PORT=9092

# LLM brain — defaults to Claude. Use a faster model for low-latency voice if desired.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8            # voice agent brain; claude-haiku-4-5 for lowest latency
LLM_EFFORT=low                      # low|medium|high — low favors latency for voice

# Speech-to-text provider: deepgram | openai | whisper-local
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Text-to-speech provider: elevenlabs | openai | azure | piper-local
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
AZURE_TTS_KEY=
AZURE_TTS_REGION=

# ---- Object storage (recordings / voicemail) — DO Spaces (S3-compatible) ----
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_REGION=nyc3
S3_BUCKET=aipbx-recordings
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# ---- Email / notifications (voicemail-to-email, alerts) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=pbx@example.com

# ---- Web frontend ----
WEB_PORT=80
VITE_API_URL=https://pbx.example.com/api
VITE_WS_URL=wss://pbx.example.com/ws
VITE_SIP_WSS_URL=wss://pbx.example.com:8089/ws
