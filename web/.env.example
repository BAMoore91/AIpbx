# AIpbx Web Frontend — Environment Variables
# Copy to .env.local and fill in real values

# Backend REST API base URL (no trailing slash)
VITE_API_URL=https://api.example.com

# WebSocket event stream URL
VITE_WS_URL=wss://api.example.com/ws

# Asterisk WebRTC WebSocket URL (JsSIP connects here)
VITE_SIP_WSS_URL=wss://pbx.example.com:8089/ws
